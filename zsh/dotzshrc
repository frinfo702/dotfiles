# Load machine-local environment variables and secrets.
typeset zsh_config_dir="${${(%):-%x}:A:h}"
[[ -r "$zsh_config_dir/.zshrc.local" ]] && source "$zsh_config_dir/.zshrc.local"
unset zsh_config_dir

# nix is set up in .zshenv; /etc/zprofile's path_helper and brew shellenv push it
# back behind the system dirs in login shells, so put it in front again.
typeset -U path
path=("$HOME/.nix-profile/bin" /nix/var/nix/profiles/default/bin $path)

autoload -Uz compinit && compinit
autoload -U +X bashcompinit && bashcompinit
complete -o nospace -C "$(command -v terraform)" terraform
eval "$(direnv hook zsh)"


# fnm

[
  {
    "context": "Terminal",
    "bindings": {
      "cmd-shift-j": [
        "action::Sequence",
        ["workspace::ZoomOut", "terminal_panel::Toggle"],
      ],
      "shift-enter": ["terminal::SendText", "\u001b\r"],
    },
  },
  {
    "bindings": {
      "cmd-shift-j": [
        "action::Sequence",
        ["terminal_panel::ToggleFocus", "workspace::ZoomIn"],
      ],
      "cmd-g": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-g": "git_panel::ToggleFocus",
    },
  },
  {
    "bindings": {
      "cmd-e": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-shift-e": "project_panel::ToggleFocus",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "j": ["workspace::SendKeystrokes", "g j"],
      "k": ["workspace::SendKeystrokes", "g k"],
    },
  },
]

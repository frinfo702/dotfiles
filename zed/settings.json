// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false,
    "show": true
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_status_icon": true,
    "show_user_picture": false,
    "show_onboarding_banner": true,
    "show_project_items": true,
    "show_user_menu": true,
    "show_sign_in": false,
    "show_branch_name": true
  },
  "debugger": {
    "button": false
  },
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": true
  },
  "status_bar": {
    "active_encoding_button": "disabled",
    "active_language_button": false,
    "cursor_position_button": false
  },
  "buffer_font_family": ".ZedMono",
  "buffer_font_features": {
    "calt": false // Disable ligatures
  },
  "show_whitespaces": "none",
  "always_treat_brackets_as_autoclosed": false,
  "code_lens": "off",
  "tabs": {
    "git_status": false,
    "file_icons": false,
    "show_diagnostics": "off"
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false
  },
  "indent_guides": {
    "enabled": false
  },
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "button": false,
    "dock": "left"
  },
  "outline_panel": {
    "button": false,
    "dock": "left"
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "terminal": {
    "button": false,
    "font_family": ".ZedMono",
    "shell": "system"
  },
  "git": {
    "inline_blame": {
      "enabled": false,
      "show_commit_summary": true
    }
  },
  "show_completions_on_input": true,
  "agent_servers": {
    "kimi": {
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "model": "haiku",
        "effort": "max",
        "mode": "bypassPermissions"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "mode": "full-access",
        "model": "gpt-5.4"
      },
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "effort": "medium",
        "model": "deepseek/deepseek-v4-flash"
      },
      "type": "registry"
    },
    "cursor": {
      "type": "registry"
    }
  },
  "git_panel": {
    "button": false,
    "dock": "left",
    "tree_view": true
  },
  "ssh_connections": [
    {
      "host": "github.com",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/doffy_pixiv_co_jp"
          ]
        }
      ]
    },
    {
      "host": "bastion.tanuking.dev",
      "args": [],
      "projects": []
    },
    {
      "host": "gitlab.tanuking.dev",
      "args": [],
      "projects": []
    },
    {
      "host": "mygateway",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/frinfo/ghq/github.com/frinfo702/3dgs-relationship-recognition"
          ]
        }
      ]
    }
  ],
  "relative_line_numbers": "enabled",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "show_edit_predictions": false,
  "agent": {
    "show_merge_conflict_indicator": true,
    "button": false,
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow",
          "always_allow": [
            {
              "pattern": "^sed\\b"
            },
            {
              "pattern": "^npx\\b"
            },
            {
              "pattern": "^python3\\b"
            }
          ]
        }
      }
    },
    "default_profile": "ask",
    "default_model": {
      "provider": "zed.dev",
      "model": "gpt-5.4",
      "enable_thinking": true,
      "effort": "high"
    },
    "play_sound_when_agent_done": "when_hidden",
    "use_modifier_to_send": false,
    "model_parameters": [],
    "enable_feedback": false
  },
  "disable_ai": false,
  "ui_font_weight": 500.0,
  "buffer_font_weight": 500.0,
  "buffer_line_height": "comfortable",
  "icon_theme": {
    "mode": "light",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha"
  },
  "helix_mode": true,
  "ui_font_size": 14,
  "buffer_font_size": 13,
  // Local theme inspired by Poolside's warm, high-contrast palette.
  "theme": {
    "mode": "dark",
    "light": "poolside-light",
    "dark": "codex-dark"
  },
  "languages": {
    "Scala": {
      "show_whitespaces": "none",
      "format_on_save": "on",
      "tab_size": 2,
      "code_actions_on_format": {
        "source.organizeImports": false // auto import TODO: restore later
      }
    },
    "YAML": {
      "format_on_save": "on",
      "formatter": "prettier"
    }
  },
  "file_scan_exclusions": [
    "**/target",
    "**/project/target",
    "**/project/project",
    "**/node_modules",
    "**/.metals",
    "**/.bloop"
  ],
  // Keep the Metals proxy path so Zed's DAP and Metals tasks remain available.
  // Zed does not implement these refresh notifications in its LSP client.
  "lsp": {
    "metals": {
      "settings": {
        "autoImportBuilds": "all",
        "bloopSbtAlreadyInstalled": false,
        "enableSemanticHighlighting": false,
        "testUserInterface": "test explorer"
      }
    },
    "jdtls": {
      "settings": {
        "java_home": "/Users/ken702/.local/share/mise/installs/java/21"
      }
    }
  },
}

font-family = Paper Mono
font-family = Noto Sans JP
font-feature = -calt, -liga, -dlig
font-size = 14
# background-image = "./wallpaper/spaceX-wallpaper.png"
background-opacity = 0.60


theme = GitHub Dark High Contrast
# Custom (files in ~/.config/ghostty/themes):
# theme = opencode-dark
# theme = opencode-light
# theme = arc-raiders-dark
# theme = arc-raiders-light
# theme = cursor-dark
# theme = cursor-light
# theme = mongodb
# theme = linear-dark
# theme = linear-light
# theme = stripe-dark
# theme = figma-dark
# theme = raycast-dark
# theme = notion-light


mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

term = xterm-256color
window-padding-balance = true
window-save-state = always
macos-titlebar-style=transparent
shell-integration = zsh
shell-integration-features = sudo, no-title, ssh-env, ssh-terminfo
notify-on-command-finish = unfocused

palette = 2=#4cb782
palette = 3=#f2c94c
palette = 4=#5e6ad2
palette = 5=#8b5cf6
palette = 6=#828fff
palette = 7=#d0d6e0
palette = 8=#62666d
palette = 9=#eb5757
palette = 10=#4cb782
palette = 11=#f2994a
palette = 12=#828fff
palette = 13=#8b5cf6
